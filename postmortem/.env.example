# Copy this file to .env and fill in the real password.
# .env is gitignored; never commit it.
#
# PREREQUISITE: the warehouse is reachable over Tailscale. A new machine must
# have Tailscale installed and be logged into the tailnet (<TAILNET_USER>@) before
# any connection will work. Verify with:  tailscale status
#
# POSTGRES_HOST below is the server's Tailscale IP (<SERVER_HOSTNAME>). It works
# from any network, including the home LAN (Tailscale routes directly there).
# On the home LAN you may also use the LAN IP <SERVER_LAN_IP> for a lower-latency
# direct path, but the Tailscale IP is the portable default.

POSTGRES_HOST=<SERVER_TAILSCALE_IP>
POSTGRES_PORT=5432
POSTGRES_DB=nba_warehouse
POSTGRES_USER=<DB_USER>
POSTGRES_PASSWORD=replace-me
POSTGRES_SCHEMA=nba
