# Kept minimal per request: commit everything in the working tree.
# Secret/OS guards only (no .env currently exists; kept as a safety if one appears later).
.env
.env.*
*.local
.DS_Store
Thumbs.db

# Remotion downloaded browser binaries + webpack build caches: rebuildable, and they exceed
# GitHub's hard 100MB-per-file limit (a 202MB chrome-headless-shell.exe would reject the push).
.remotion/
**/node_modules/.cache/
