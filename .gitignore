# Kept minimal per request: commit everything in the working tree.
# Secret/OS guards only (no .env currently exists; kept as a safety if one appears later).
.env
.env.*
*.local
.DS_Store
Thumbs.db

# Remotion downloaded browser binaries + webpack build caches: rebuildable, and they exceed
# GitHub's hard 100MB-per-file limit (a 202MB chrome-headless-shell.exe would reject the push).
.remotion/
**/node_modules/.cache/

# RAPM possession cache: large rebuildable intermediate (src/models/build_possessions.py),
# actively regenerated; not a source artifact. Rebuild from the stint pipeline.
counterfactual-fit-engine/data/cache/possessions/
# D6 DuckDB store: rebuildable from the stint cache via src/etl/load_duckdb.py
counterfactual-fit-engine/data/fitengine.duckdb
counterfactual-fit-engine/data/fitengine.duckdb.wal
# Derived feature tables: rebuildable from code + caches via src/etl/{player_features,lineup_obs}.py
counterfactual-fit-engine/outputs/features/*.parquet
# Stint cache: rebuildable intermediate (src/stints/run_panel.py writes it alongside the
# possession cache); was only partially/accidentally tracked. Rebuild from the panel run.
counterfactual-fit-engine/data/cache/stints/
# Raw MCMC sample checkpoint: crash-recovery artifact, regenerable; the S x K
# skill_vectors samples (spec 7.4 handoff) are committed separately.
counterfactual-fit-engine/outputs/skill_vectors/samples_*.npz
counterfactual-fit-engine/outputs/skill_vectors/samples_*.health.json
